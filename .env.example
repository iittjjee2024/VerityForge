# Copy to .env and fill in. .env is gitignored; never commit real keys.
# --- Bifrost gateway (you run it yourself; it does not issue keys) ---
# Start:  npx -y @maximhq/bifrost   (UI at http://localhost:8080, add your upstream provider key there)
BIFROST_BASE_URL=http://localhost:8080
# Only needed if you enable Bifrost virtual keys
BIFROST_API_KEY=
# Upstream provider keys — referenced by bifrost/config.json as env.GROQ_API_KEY etc.
GROQ_API_KEY=
GEMINI_API_KEY=
# Models as '<provider>/<model>' (defaults shown; Groq has a free tier)
VERITYFORGE_SMALL_MODEL=groq/openai/gpt-oss-20b
VERITYFORGE_LARGE_MODEL=groq/openai/gpt-oss-120b
# Verification judge model (Gemini flash-lite avoids reasoning-token rate limits)
VERITYFORGE_JUDGE_MODEL=gemini/gemini-flash-lite-latest
# Optional model on a DIFFERENT provider, used for failover
VERITYFORGE_FALLBACK_MODEL=
# Optional pricing (USD per 1M tokens) for budget enforcement; unknown models use a conservative default
VERITYFORGE_PRICING={}
# --- Tavily web research. Leave empty to use mock mode. ---
TAVILY_API_KEY=
# --- Local model backend (OpenAI-compatible, e.g. Ollama), required for confidential repos ---
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=
# Set to false to use the live gateway (true = deterministic mocks, for tests/demos only)
VERITYFORGE_MOCK_MODE=true
# --- Authentication. Disabled (local 'local' user) unless BOTH are set. Enforced in the backend. ---
# Signing secret for bearer tokens (set a long random value in any real deployment)
VERITYFORGE_AUTH_SECRET=
# Users as "user:pass,user2:pass2" (demo-grade; swap for a real identity store in production)
VERITYFORGE_USERS=
# --- Persistence (telemetry + audit survive restarts). Off unless VERITYFORGE_PERSIST=true ---
VERITYFORGE_PERSIST=false
# Store URL: sqlite:///./verityforge.db  OR  postgres://user:pass@host:5432/db (needs psycopg)
# Falls back to DATABASE_URL if VERITYFORGE_STORE_URL is unset.
VERITYFORGE_STORE_URL=
DATABASE_URL=postgresql://verityforge:change-me@localhost:5432/verityforge
REDIS_URL=redis://localhost:6379/0
